# API credentials: Action1 console -> Configuration -> Users & API Credentials
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=
# Region base URL. EU: https://app.eu.action1.com/api/3.0
# NA: https://app.action1.com/api/3.0, AU: https://app.au.action1.com/api/3.0
ACTION1_BASE_URL=https://app.eu.action1.com/api/3.0
ACTION1_TIMEOUT_MS=30000
# The single write tool (patch approvals) requires exactly "true".
# Script execution / automations / remote sessions are NOT exposed at all.
ACTION1_ENABLE_WRITES=false
ACTION1_AUDIT_LOG=
# HTTP transport: bearer token required on every /mcp request (compared in
# constant time). At least 32 printable ASCII characters (`openssl rand -hex 32`).
# Required when MCP_HTTP_HOST is not a loopback address or MCP_ALLOW_ANY_ORIGIN=true.
MCP_HTTP_TOKEN=
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# Escape hatch: serve /mcp without a token on a non-loopback bind.
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
# MCP_MAX_BODY_BYTES=10485760
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_ALLOWED_HOSTS=
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
