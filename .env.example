# API credentials: Action1 console -> Configuration -> Users & API Credentials
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=
# Region base URL. EU: https://app.eu.action1.com/api/3.0
# NA: https://app.action1.com/api/3.0, AU: https://app.au.action1.com/api/3.0
ACTION1_BASE_URL=https://app.eu.action1.com/api/3.0
ACTION1_TIMEOUT_MS=30000
# The single write tool (patch approvals) requires exactly "true".
# Script execution / automations / remote sessions are NOT exposed at all.
ACTION1_ENABLE_WRITES=false
ACTION1_AUDIT_LOG=
