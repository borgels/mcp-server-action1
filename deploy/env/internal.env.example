# Shared across every MCP server in a fleet deployment. If the /mcp port is published
# on a loopback address reachable by anything other than your own gateway, set
# MCP_HTTP_TOKEN so it isn't left open — the gateway should send this same bearer.
MCP_HTTP_HOST=0.0.0.0
PORT=3000
MCP_HTTP_TOKEN=<shared loopback bearer, generate with `openssl rand -hex 32`>
