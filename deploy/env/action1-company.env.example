# Per-organization Action1 API credentials. Copy this file to
# env/action1-<company>.env for each organization instance (matching the compose
# service and hosts.json entry names). Mint credentials under Action1 console ->
# Configuration -> Users & API Credentials for the org this instance should read.
# Never commit the real values.
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=
# Region base URL. EU: https://app.eu.action1.com/api/3.0
# NA: https://app.action1.com/api/3.0, AU: https://app.au.action1.com/api/3.0
ACTION1_BASE_URL=https://app.eu.action1.com/api/3.0
# Leave false unless this instance should be able to approve/decline patches.
ACTION1_ENABLE_WRITES=false
